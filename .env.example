# Autonomous Agentic Playwright Framework Environment Configuration

# Browser Options
BROWSER_TYPE=chromium
HEADLESS=true
SLOW_MO=0.0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
DEFAULT_TIMEOUT=15000.0
NAVIGATION_TIMEOUT=30000.0

# LLM Agent Configuration (auto, openai, gemini, anthropic, mock)
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

# Execution & Healing Options
ARTIFACTS_DIR=output/artifacts
REGISTRY_FILE=locator.registry.json
ENABLE_SELF_HEAL=true
MAX_HEAL_RETRIES=2
ENABLE_TRACING=true
ENABLE_VIDEO=true
MASK_SENSITIVE_DATA=true
